# Copy this file to .env.local and fill in real values for local dev.
# In Vercel, set these as Project > Settings > Environment Variables instead.

# Base URL of the FastAPI backend (web/backend), no trailing slash.
# Local dev example: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose client-side; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
