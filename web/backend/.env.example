# Copy to .env and fill in for a real deployment. Every value has a
# working local-dev default in app/config.py, so .env is optional for
# running against local SQLite + MinIO.

DATABASE_URL=postgresql://user:password@localhost:5432/katgaireel

SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed as a fallback for HS256-signed tokens (older projects, or a
# not-yet-expired token from before a migration) - see app/auth.py.
# Newer projects verify via SUPABASE_URL's JWKS endpoint instead; leave unset if you only see "JWT Signing Keys" (not a "Legacy JWT Secret" with a value) in your dashboard.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=katgaireel-prod

CLIP_SCORING_PROVIDER=openrouter
OPENROUTER_API_KEY=...
# LOCAL_LLM_BASE_URL=http://mac-mini.tailXXXX.ts.net:11434/v1   # for CLIP_SCORING_PROVIDER=local

QUEUE_BACKEND=local
# QUEUE_BACKEND=cloud_tasks
INTERNAL_BASE_URL=https://api.katgaireel.io
# GCP_PROJECT_ID=...
# GCP_LOCATION=us-central1
# CLOUD_TASKS_QUEUE_NAME=katgaireel-jobs
