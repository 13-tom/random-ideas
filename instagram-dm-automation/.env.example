# --- Meta App credentials (developers.facebook.com) ---
META_APP_SECRET=replace_me

# --- Webhook verification token (you make this up, enter the same value in the Meta App dashboard) ---
WEBHOOK_VERIFY_TOKEN=replace_me

# --- Long-lived Page access token with instagram_manage_messages / instagram_manage_comments scopes ---
PAGE_ACCESS_TOKEN=replace_me

# --- Instagram Business Account ID (the IG account being automated) ---
IG_BUSINESS_ACCOUNT_ID=replace_me

# --- Server ---
PORT=3000

# --- Database (SQLite by default; swap for a Postgres URL later without code changes) ---
DATABASE_URL="file:./dev.db"
